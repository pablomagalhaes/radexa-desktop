{
  "name": "radexa-desktop",
  "productName": "Radexa",
  "version": "1.0.3",
  "description": "Radexa Desktop — dite e cole laudos por cima do sistema em que você lauda (Clinux, RIS…).",
  "main": "src/main.js",
  "author": "Radexa <contato@radexa.com.br>",
  "homepage": "https://radexa.com.br",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:local": "cross-env RADEXA_URL=http://localhost:8080 electron .",
    "test": "node --test test/rules.test.js",
    "icons": "python3 scripts/make-icons.py",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "br.com.radexa.desktop",
    "productName": "Radexa",
    "copyright": "© Radexa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.medical",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Radexa usa o microfone para você ditar o laudo.",
        "NSAppleEventsUsageDescription": "O Radexa cola o laudo no programa em que você está laudando.",
        "LSUIElement": false
      },
      "artifactName": "Radexa-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Radexa",
      "artifactName": "Radexa-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Radexa",
      "artifactName": "Radexa-Setup.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pablomagalhaes/radexa-desktop.git"
  }
}
